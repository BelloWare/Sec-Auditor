# Sec-Auditor environment configuration.
# The application does not automatically load .env. Copy, edit, then inject
# these variables through your launcher, or source your reviewed copy with:
#   set -a
#   . ./.env
#   set +a
# JSON values are single-quoted here so this file can be sourced by a POSIX shell.
# No raw Google credentials, service-account keys, or MCP bearer tokens belong here.

# REQUIRED: At least one scope allowlist. Replace this example numeric org ID.
# Organizations authorize resources proven to be descendants of those orgs.
SEC_AUDITOR_ALLOWED_ORGANIZATIONS='["123456789012"]'
# Alternatively/additionally list explicit project IDs or project numbers.
SEC_AUDITOR_ALLOWED_PROJECTS='[]'
# Optional Google quota project. The runtime identity must be allowed to consume
# APIs there. Leave unset to use normal ADC/API quota attribution.
# SEC_AUDITOR_QUOTA_PROJECT='your-security-project-id'

# HTTP caller authentication: jwt (preferred) or static. Stdio uses local process
# trust and does not require these HTTP authentication settings.
SEC_AUDITOR_AUTH_MODE='jwt'
# Exact issuer, dedicated MCP audience, and HTTPS JWKS endpoint; replace examples.
SEC_AUDITOR_JWT_ISSUER='https://issuer.example.com/'
SEC_AUDITOR_JWT_AUDIENCE='sec-auditor'
SEC_AUDITOR_JWKS_URL='https://issuer.example.com/.well-known/jwks.json'
# Asymmetric algorithms only: RS256/384/512 or ES256/384/512.
SEC_AUDITOR_JWT_ALGORITHMS='["RS256"]'
# JWT HTTP mode requires an explicit nonempty subject allowlist.
SEC_AUDITOR_ALLOWED_SUBJECTS='["your-security-agent-subject"]'
# All listed scopes must appear in the JWT's scope string or scp array.
SEC_AUDITOR_REQUIRED_SCOPES='["security:read"]'
# Static mode only: {"caller-name":"64-character-SHA256-hex-digest"}.
# Run sec-auditor hash-token to hash a strong random token supplied privately.
# The client holds the raw token; the server configuration holds only its digest.
# Static mode has no interactive OAuth issuer/discovery flow.
SEC_AUDITOR_STATIC_TOKENS='{}'

# Public HTTPS URL ending /mcp. HTTP is accepted only for loopback development.
SEC_AUDITOR_PUBLIC_URL='https://sec-auditor.example.com/mcp'
# Bind address; CLI --host/--port override. Container manifests use 0.0.0.0.
SEC_AUDITOR_HOST='127.0.0.1'
SEC_AUDITOR_PORT=8000
# Expected Host headers. Empty uses the configured public host plus local defaults.
SEC_AUDITOR_ALLOWED_HOSTS='["sec-auditor.example.com","localhost:*","127.0.0.1:*"]'
# Explicit browser origins if needed; non-browser machine clients need none.
SEC_AUDITOR_ALLOWED_ORIGINS='[]'

# SQLite jobs, sanitized evidence, and cursor state. Use a writable durable volume
# and exactly one server process/replica. Kubernetes example uses /data/....
SEC_AUDITOR_STATE_PATH='.state/sec-auditor.sqlite3'

# Process-wide request scheduling. Limits are not shared between replicas.
SEC_AUDITOR_MAX_CONCURRENCY=12
SEC_AUDITOR_PER_API_CONCURRENCY=4
SEC_AUDITOR_REQUESTS_PER_SECOND=5
# Request timeout in seconds and additional retry count for transient failures.
SEC_AUDITOR_REQUEST_TIMEOUT=30
SEC_AUDITOR_REQUEST_RETRIES=2
# Upstream cloud response bound and serialized MCP response bound, in bytes.
# Kubernetes has its own additional response limit; reduce page size if needed.
SEC_AUDITOR_MAX_API_RESPONSE_BYTES=16000000
SEC_AUDITOR_MAX_RESPONSE_BYTES=500000

# Caller batch/page limits. Native APIs can impose a smaller page limit.
SEC_AUDITOR_MAX_BATCH_SIZE=20
SEC_AUDITOR_MAX_PAGE_SIZE=200
# Maximum allowed log query window in hours.
SEC_AUDITOR_MAX_LOG_HOURS=24

# Total budgets per durable assessment, including all targets and selected kinds.
# Hitting a budget leaves coverage incomplete; split large scans deliberately.
SEC_AUDITOR_MAX_SCAN_PAGES=20
SEC_AUDITOR_MAX_SCAN_RESOURCES=5000
SEC_AUDITOR_MAX_SCAN_SECONDS=600
# Maximum queued/running job pressure accepted by this process/store.
SEC_AUDITOR_MAX_PENDING_JOBS=20

# Evidence and cursor expiration, in seconds; job retention is separate.
SEC_AUDITOR_EVIDENCE_TTL_SECONDS=3600
SEC_AUDITOR_RETENTION_SECONDS=86400
# Cache project ancestry for this many seconds; 0 disables that cache.
SEC_AUDITOR_SCOPE_CACHE_SECONDS=60

# GKE control-plane endpoint preference: auto, dns, private, public.
# Connectivity and authorization must exist; this never disables TLS verification.
SEC_AUDITOR_KUBERNETES_ENDPOINT='auto'

# Alibaba account boundary (independent of Google ADC). Leave empty for GCP only.
SEC_AUDITOR_ALLOWED_ALICLOUD_ACCOUNTS='[]'
# Permitted regional API endpoints/home regions, not finding resource isolation.
SEC_AUDITOR_ALLOWED_ALICLOUD_REGIONS='[]'
# Registered ACK canonical cluster -> server/ca_file/token_file. Trusted operator input.
# See docs/alicloud-deployment.md for rotating token projection and explicit RBAC.
SEC_AUDITOR_ALICLOUD_KUBERNETES_CLUSTERS='{}'
# Registered SLS alias -> account_id/region/project/logstore/category.
SEC_AUDITOR_ALICLOUD_LOGSTORES='{}'
